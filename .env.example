# ============ 漫画多语言智能翻译系统 环境配置 ============
# 复制为 .env 后按需修改

# 翻译流水线模式: real（真实OCR，需安装 requirements-ai.txt） | demo（无需模型）
MANGA_PIPELINE_MODE=real

# 翻译后端: google | mymemory | deepl | openai
MANGA_TRANSLATOR_BACKEND=google

# DeepL（可选，需自行申请 API Key）
# MANGA_DEEPL_AUTH_KEY=

# OpenAI 兼容接口（可选）
# MANGA_OPENAI_API_KEY=
# MANGA_OPENAI_BASE_URL=https://api.openai.com/v1
# MANGA_OPENAI_MODEL=gpt-4o-mini

# 文件限制
MANGA_MAX_UPLOAD_MB=10

# 服务地址
MANGA_HOST=0.0.0.0
MANGA_PORT=8000
