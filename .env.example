# ============ 漫画多语言智能翻译系统 环境配置 ============
# 复制为 .env 后按需修改

# 翻译流水线模式: real（真实OCR，需安装 requirements-ai.txt） | demo（无需模型）
MANGA_PIPELINE_MODE=real

# 翻译后端: deepseek | google | mymemory | deepl | openai
MANGA_TRANSLATOR_BACKEND=deepseek

# DeepSeek API（漫画口语翻译最自然）
# MANGA_DEEPSEEK_API_KEY=sk-xxxxxxx
MANGA_DEEPSEEK_MODEL=deepseek-chat
MANGA_DEEPSEEK_BASE_URL=https://api.deepseek.com

# DeepL API Key（可选，需自行申请；免费版 key 以 :fx 结尾）
# MANGA_DEEPL_AUTH_KEY=

# OpenAI 兼容接口（可选）
# MANGA_OPENAI_API_KEY=
# MANGA_OPENAI_BASE_URL=https://api.openai.com/v1
# MANGA_OPENAI_MODEL=gpt-4o-mini

# 修复引擎: cv（无模型，默认） | lama（神经网络，需 backend/requirements-inpaint.txt）
MANGA_INPAINTER_BACKEND=cv
# LaMa 权重路径（可选；默认自动搜索 backend/data/models/lama_large_512px.ckpt）
# MANGA_LAMA_MODEL_PATH=
# LaMa 推理缩放上限（最长边像素；CPU 建议 1024以内）
MANGA_LAMA_INPAINT_SIZE=1024
# 修复设备: cpu | cuda
MANGA_INPAINT_DEVICE=cpu

# ============ MIT 检测/OCR（移植自 manga-image-translator，默认） ============
# OCR 引擎:
#   mit48（默认，漫画专精 48px 自训模型） | paddle（PaddleOCR，回退）
#   mangaocr（kha-white/manga-ocr-base，风格化字体更强，需安装 manga-ocr + HF 权重）
#   mit48+mangaocr（混合：48px 概率低的行自动用 manga-ocr 补识别，最准但较慢）
MANGA_OCR_BACKEND=mit48
# 识别优化：字号小于该值(px)的文本行先放大 2x 再识别（增强小字/风格化字体召回）
MANGA_MIT_OCR_UPSCALE=16
# 混合模式 mit48+mangaocr 的切换阈值：48px 概率低于该值时改用 manga-ocr 补识别
MANGA_MIT_OCR_MIX_THRESHOLD=0.7
# 检测引擎: 空（自动） | cv | manga（默认 DBNet，可切 ctd）
# 自动逻辑: OCR 用 mit48 时自动选 manga，否则 cv
# MANGA_DETECTOR_BACKEND=
# MIT 检测器类型: default（DBNet+ResNet34） | ctd（ComicTextDetector，画质要求更高）
MANGA_MIT_DETECTOR=default
# MIT 推理设备: cpu | cuda | mps | auto
MANGA_MIT_DEVICE=cpu
# MIT 模型权重目录（默认 backend/data/models/mit；可指向已下载的 MIT 仓库 models/）
# MANGA_MIT_MODEL_DIR=
# 回退权重目录（可选，mit_model_dir 缺失时使用）
# MANGA_MIT_FALLBACK_DIR=
# MIT 检测参数（一般不用改）
MANGA_MIT_DETECT_SIZE=1280
# MANGA_MIT_TEXT_THRESHOLD=0.7
# MANGA_MIT_BOX_THRESHOLD=0.7
# MANGA_MIT_UNCLIP_RATIO=2.2
# MANGA_MIT_OCR_PROB=0.2
# MIT 掩膜级气泡去噪: 1-50（越小越激进，拟声词不擦除） | 0 关闭（默认）
MANGA_MIT_IGNORE_BUBBLE=0
# 气泡过滤: auto（MIT 模式自动关闭白占比启发式） | on | off
MANGA_BUBBLE_FILTER=auto

# 文件限制
MANGA_MAX_UPLOAD_MB=10

# 服务地址
MANGA_HOST=0.0.0.0
MANGA_PORT=8000
